<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.healthdesk.controller.BillingController"
      spacing="16" style="-fx-padding: 20px;">

    <!-- TOP FILTER & STATS BAR -->
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="card" style="-fx-padding: 10px 16px;">
        <Label text="Filter by Patient:" style="-fx-font-weight: bold; -fx-text-fill: #334155;"/>
        <TextField fx:id="filterField" promptText="Enter patient name..." prefWidth="250" onKeyReleased="#handleFilter"/>
        <ComboBox fx:id="statusFilterCombo" prefWidth="140" onAction="#handleFilter"/>
        <Button text="🔄 Refresh" onAction="#loadBills" styleClass="btn-secondary"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="📄 View / Print Invoice Receipt" onAction="#handleViewReceiptDialog" styleClass="btn-secondary"/>
        <Label fx:id="revenueLabel" text="Total: $0.00" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #16a34a;"/>
    </HBox>

    <!-- MAIN BODY: BILLS TABLE + BILL GENERATOR -->
    <HBox spacing="16" VBox.vgrow="ALWAYS">

        <!-- BILLS TABLE -->
        <VBox HBox.hgrow="ALWAYS" styleClass="card" spacing="10">
            <Label text="Patient Invoices &amp; Billing Records" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
            <TableView fx:id="billTableView" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="Invoice #" prefWidth="70"/>
                    <TableColumn fx:id="colDate" text="Date" prefWidth="85"/>
                    <TableColumn fx:id="colPatient" text="Patient Name" prefWidth="150"/>
                    <TableColumn fx:id="colConsultation" text="Consultation" prefWidth="95"/>
                    <TableColumn fx:id="colLab" text="Lab Fee" prefWidth="80"/>
                    <TableColumn fx:id="colBed" text="Bed Fee" prefWidth="80"/>
                    <TableColumn fx:id="colMedicine" text="Medicine" prefWidth="80"/>
                    <TableColumn fx:id="colOther" text="Other" prefWidth="70"/>
                    <TableColumn fx:id="colTotal" text="Total ($)" prefWidth="95"/>
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="90"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>

        <!-- BILL GENERATOR FORM -->
        <VBox prefWidth="380" styleClass="card" spacing="12">
            <Label text="Generate Patient Bill" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
            <Separator/>

            <VBox spacing="4">
                <Label text="Select Patient *" style="-fx-font-size: 11px; -fx-font-weight: 600;"/>
                <ComboBox fx:id="patientCombo" maxWidth="Infinity" promptText="Choose patient..."/>
            </VBox>

            <GridPane hgap="10" vgap="8">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>

                <VBox spacing="2" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Consultation Fee ($)" style="-fx-font-size: 11px;"/>
                    <TextField fx:id="consultationFeeField" text="500.0"/>
                </VBox>

                <VBox spacing="2" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Laboratory Fee ($)" style="-fx-font-size: 11px;"/>
                    <TextField fx:id="labFeeField" text="300.0"/>
                </VBox>

                <VBox spacing="2" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label text="Bed / Ward Fee ($)" style="-fx-font-size: 11px;"/>
                    <TextField fx:id="bedFeeField" text="0.0"/>
                </VBox>

                <VBox spacing="2" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label text="Medicine Fee ($)" style="-fx-font-size: 11px;"/>
                    <TextField fx:id="medicineFeeField" text="0.0"/>
                </VBox>

                <VBox spacing="2" GridPane.columnIndex="0" GridPane.rowIndex="2">
                    <Label text="Other Charges ($)" style="-fx-font-size: 11px;"/>
                    <TextField fx:id="otherFeeField" text="0.0"/>
                </VBox>

                <VBox spacing="2" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <Label text="Payment Status" style="-fx-font-size: 11px;"/>
                    <ComboBox fx:id="statusCombo" maxWidth="Infinity"/>
                </VBox>
            </GridPane>

            <!-- LIVE CALCULATED TOTAL BOX -->
            <VBox spacing="4" alignment="CENTER"
                  style="-fx-background-color: #f0fdf4; -fx-border-color: #86efac; -fx-background-radius: 8px; -fx-border-radius: 8px; -fx-padding: 12px;">
                <Label text="AUTOMATICALLY CALCULATED TOTAL:" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #166534;"/>
                <Label fx:id="lblCalculatedTotal" text="$800.00" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #15803d;"/>
            </VBox>

            <Separator/>

            <!-- ACTION BUTTONS -->
            <Button text="💵 Generate &amp; Save Bill" onAction="#handleGenerateBill" maxWidth="Infinity"
                    styleClass="btn-primary" style="-fx-font-size: 13px; -fx-padding: 9px;"/>

            <HBox spacing="8">
                <Button text="✅ Mark Paid" onAction="#handleMarkPaid" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-success"/>
                <Button text="🗑️ Delete" onAction="#handleDeleteBill" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-danger"/>
            </HBox>

            <Button text="🧹 Clear Fields" onAction="#handleClearForm" maxWidth="Infinity" styleClass="btn-secondary"/>
        </VBox>

    </HBox>
</VBox>
