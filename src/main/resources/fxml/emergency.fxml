<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.healthdesk.controller.EmergencyController"
      spacing="16" style="-fx-padding: 20px;">

    <!-- TOP TRIAGE BANNER & PROCESS NEXT ACTION -->
    <HBox spacing="16" alignment="CENTER_LEFT" styleClass="card"
          style="-fx-background-color: linear-gradient(to right, #ffffff, #fff1f2); -fx-border-color: #fca5a5;">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="🚨" style="-fx-font-size: 24px;"/>
                <Label text="Emergency Department Triage Queue" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #991b1b;"/>
            </HBox>
            <Label text="Patients prioritized using Java PriorityQueue: 1 = Emergency (Immediate) > 2 = Critical > 3 = Normal (Stable)."
                   style="-fx-text-fill: #7f1d1d; -fx-font-size: 12px;"/>
        </VBox>

        <!-- Up Next Indicator & Action Button -->
        <VBox spacing="4" alignment="CENTER_RIGHT">
            <Label fx:id="lblUpNext" text="Next in Line: None" style="-fx-font-weight: bold; -fx-text-fill: #991b1b; -fx-font-size: 13px;"/>
            <Button text="🚨 Process Next Patient" onAction="#handleProcessNext"
                    styleClass="btn-danger" style="-fx-font-size: 14px; -fx-padding: 10px 22px; -fx-background-radius: 8px;"/>
        </VBox>
    </HBox>

    <!-- MAIN BODY: QUEUE TABLE + ADMISSION FORM -->
    <HBox spacing="16" VBox.vgrow="ALWAYS">

        <!-- TRIAGE QUEUE TABLE -->
        <VBox HBox.hgrow="ALWAYS" styleClass="card" spacing="10">
            <HBox alignment="CENTER_LEFT">
                <Label text="Active Triage Queue (Ordered by Priority)" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <CheckBox fx:id="chkShowAll" text="Show full history" onAction="#loadQueueData"/>
            </HBox>

            <TableView fx:id="emergencyTableView" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colPriority" text="Priority" prefWidth="120"/>
                    <TableColumn fx:id="colPatient" text="Patient Name" prefWidth="170"/>
                    <TableColumn fx:id="colCondition" text="Condition / Symptoms" prefWidth="240"/>
                    <TableColumn fx:id="colStatus" text="Triage Status" prefWidth="120"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>

        <!-- ADMISSION FORM -->
        <VBox prefWidth="380" styleClass="card" spacing="12">
            <Label text="Admit Emergency Patient" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
            <Separator/>

            <VBox spacing="4">
                <Label text="Select Patient *" style="-fx-font-size: 12px; -fx-font-weight: 600;"/>
                <ComboBox fx:id="patientCombo" maxWidth="Infinity" promptText="Select registered patient..."/>
            </VBox>

            <VBox spacing="4">
                <Label text="Triage Priority Level *" style="-fx-font-size: 12px; -fx-font-weight: 600;"/>
                <ComboBox fx:id="priorityCombo" maxWidth="Infinity"/>
                <Label text="Priority 1: Immediate resuscitation / life-threat&#10;Priority 2: Severe trauma or critical pain&#10;Priority 3: Urgent / stable condition"
                       style="-fx-font-size: 10px; -fx-text-fill: #64748b;"/>
            </VBox>

            <VBox spacing="4">
                <Label text="Clinical Condition / Symptoms *" style="-fx-font-size: 12px; -fx-font-weight: 600;"/>
                <TextArea fx:id="conditionArea" promptText="Describe chief complaints, vitals, acute injuries..." prefRowCount="4" wrapText="true"/>
            </VBox>

            <Separator/>

            <Button text="🚨 Add to Emergency Queue" onAction="#handleEnqueue" maxWidth="Infinity"
                    styleClass="btn-danger" style="-fx-font-size: 14px; -fx-padding: 10px;"/>

            <Button text="🧹 Clear Fields" onAction="#handleClear" maxWidth="Infinity" styleClass="btn-secondary"/>

            <!-- Priority Stats Card -->
            <VBox spacing="6" style="-fx-background-color: #f8fafc; -fx-padding: 12px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
                <Label text="Triage Summary:" style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #475569;"/>
                <HBox spacing="10">
                    <Label fx:id="lblP1Count" text="Priority 1: 0" style="-fx-text-fill: #dc2626; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                    <Label fx:id="lblP2Count" text="Priority 2: 0" style="-fx-text-fill: #d97706; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                    <Label fx:id="lblP3Count" text="Priority 3: 0" style="-fx-text-fill: #0284c7; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                </HBox>
            </VBox>
        </VBox>

    </HBox>
</VBox>
