<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.healthdesk.controller.PatientHistoryController"
      spacing="16" style="-fx-padding: 20px;">

    <!-- TOP PATIENT SELECTOR BAR -->
    <HBox spacing="14" alignment="CENTER_LEFT" styleClass="card" style="-fx-padding: 12px 18px;">
        <Label text="Select Patient Dossier:" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #334155;"/>
        <ComboBox fx:id="patientCombo" prefWidth="350" promptText="Choose patient to inspect history..." onAction="#handlePatientSelected"/>
        <Button text="🔄 Refresh Data" onAction="#loadPatients" styleClass="btn-secondary"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="📄 Print Full Dossier Summary" onAction="#handlePrintDossier" styleClass="btn-primary"/>
    </HBox>

    <!-- PATIENT DEMOGRAPHICS & BED CARD -->
    <HBox spacing="20" styleClass="card" alignment="CENTER_LEFT" style="-fx-padding: 16px 20px;">
        <Label text="👤" style="-fx-font-size: 38px;"/>
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <HBox spacing="10" alignment="BASELINE_LEFT">
                <Label fx:id="lblName" text="Select a patient above" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                <Label fx:id="lblBloodGroup" text="B+" styleClass="badge-role" style="-fx-background-color: #fee2e2; -fx-text-fill: #991b1b;"/>
            </HBox>
            <HBox spacing="20">
                <Label fx:id="lblAgeGender" text="Age: - | Gender: -" style="-fx-text-fill: #64748b;"/>
                <Label fx:id="lblPhone" text="Phone: -" style="-fx-text-fill: #64748b;"/>
                <Label fx:id="lblAddress" text="Address: -" style="-fx-text-fill: #64748b;"/>
            </HBox>
        </VBox>

        <!-- Current Bed Assignment Card -->
        <VBox spacing="2" style="-fx-background-color: #f0fdf4; -fx-padding: 10px 16px; -fx-background-radius: 8px; -fx-border-color: #bbf7d0; -fx-border-radius: 8px;">
            <Label text="Inpatient Bed Allocation:" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #166534;"/>
            <Label fx:id="lblBedInfo" text="Not Currently Admitted" style="-fx-font-weight: bold; -fx-text-fill: #15803d; -fx-font-size: 13px;"/>
        </VBox>
    </HBox>

    <!-- UNIFIED MEDICAL DOSSIER TAB PANE -->
    <TabPane VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE" styleClass="card" style="-fx-padding: 6px;">

        <!-- TAB 1: APPOINTMENTS -->
        <Tab text="📅 Outpatient Appointments">
            <VBox spacing="8" style="-fx-padding: 12px;">
                <TableView fx:id="appointmentsTableView" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colApptDate" text="Date" prefWidth="100"/>
                        <TableColumn fx:id="colApptTime" text="Time" prefWidth="80"/>
                        <TableColumn fx:id="colApptDoctor" text="Doctor / Specialist" prefWidth="200"/>
                        <TableColumn fx:id="colApptStatus" text="Status" prefWidth="120"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </Tab>

        <!-- TAB 2: LABORATORY TESTS & RESULTS -->
        <Tab text="🔬 Laboratory Tests &amp; Diagnostics">
            <VBox spacing="8" style="-fx-padding: 12px;">
                <TableView fx:id="labTableView" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colLabDate" text="Date" prefWidth="100"/>
                        <TableColumn fx:id="colLabTest" text="Diagnostic Test" prefWidth="180"/>
                        <TableColumn fx:id="colLabDoctor" text="Ordering Doctor" prefWidth="160"/>
                        <TableColumn fx:id="colLabStatus" text="Status" prefWidth="110"/>
                        <TableColumn fx:id="colLabResult" text="Clinical Findings &amp; Results" prefWidth="280"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </Tab>

        <!-- TAB 3: PRESCRIPTIONS -->
        <Tab text="💊 Medications &amp; Prescriptions">
            <VBox spacing="8" style="-fx-padding: 12px;">
                <TableView fx:id="prescriptionsTableView" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colRxDate" text="Date" prefWidth="100"/>
                        <TableColumn fx:id="colRxDoctor" text="Doctor" prefWidth="160"/>
                        <TableColumn fx:id="colRxMedicine" text="Medicine Name" prefWidth="150"/>
                        <TableColumn fx:id="colRxDosage" text="Dosage" prefWidth="90"/>
                        <TableColumn fx:id="colRxDuration" text="Duration" prefWidth="90"/>
                        <TableColumn fx:id="colRxInstructions" text="Instructions" prefWidth="220"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </Tab>

        <!-- TAB 4: BILLING HISTORY -->
        <Tab text="💵 Financial Invoices &amp; Bills">
            <VBox spacing="8" style="-fx-padding: 12px;">
                <TableView fx:id="billsTableView" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colBillId" text="Invoice #" prefWidth="80"/>
                        <TableColumn fx:id="colBillDate" text="Date" prefWidth="100"/>
                        <TableColumn fx:id="colBillConsult" text="Consultation ($)" prefWidth="110"/>
                        <TableColumn fx:id="colBillLab" text="Lab ($)" prefWidth="90"/>
                        <TableColumn fx:id="colBillBed" text="Bed ($)" prefWidth="90"/>
                        <TableColumn fx:id="colBillMed" text="Medicine ($)" prefWidth="90"/>
                        <TableColumn fx:id="colBillTotal" text="Total ($)" prefWidth="110"/>
                        <TableColumn fx:id="colBillStatus" text="Status" prefWidth="100"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </Tab>

    </TabPane>
</VBox>
