<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.healthdesk.controller.AppointmentController"
      spacing="16" style="-fx-padding: 20px;">

    <!-- TOP FILTER & STATS BAR -->
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="card" style="-fx-padding: 12px 16px;">
        <Label text="Filter:" style="-fx-font-weight: bold; -fx-text-fill: #334155;"/>
        <TextField fx:id="filterField" promptText="Filter by patient or doctor name..." prefWidth="280" onKeyReleased="#handleFilter"/>
        <ComboBox fx:id="statusFilterCombo" prefWidth="150" promptText="All Statuses" onAction="#handleFilter"/>
        <Button text="🔄 Refresh" onAction="#handleReset" styleClass="btn-secondary"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="apptSummaryLabel" text="Total: 0 | Scheduled: 0" style="-fx-font-weight: bold; -fx-text-fill: #0284c7;"/>
    </HBox>

    <!-- MAIN BODY: APPOINTMENT TABLE + BOOKING FORM -->
    <HBox spacing="16" VBox.vgrow="ALWAYS">

        <!-- APPOINTMENTS TABLE -->
        <VBox HBox.hgrow="ALWAYS" styleClass="card" spacing="10">
            <Label text="Scheduled Outpatient Appointments" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
            <TableView fx:id="appointmentTableView" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="45"/>
                    <TableColumn fx:id="colDate" text="Date" prefWidth="95"/>
                    <TableColumn fx:id="colTime" text="Time" prefWidth="75"/>
                    <TableColumn fx:id="colPatient" text="Patient Name" prefWidth="160"/>
                    <TableColumn fx:id="colDoctor" text="Doctor / Specialist" prefWidth="180"/>
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="100"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>

        <!-- BOOKING / RESCHEDULE FORM -->
        <VBox prefWidth="380" styleClass="card" spacing="12">
            <Label text="Book / Manage Appointment" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
            <Separator/>

            <VBox spacing="4">
                <Label text="Select Patient *" style="-fx-font-size: 12px; -fx-font-weight: 600;"/>
                <ComboBox fx:id="patientCombo" maxWidth="Infinity" promptText="Choose patient..."/>
            </VBox>

            <VBox spacing="4">
                <Label text="Select Doctor *" style="-fx-font-size: 12px; -fx-font-weight: 600;"/>
                <ComboBox fx:id="doctorCombo" maxWidth="Infinity" promptText="Choose doctor..."/>
            </VBox>

            <HBox spacing="10">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Appointment Date *" style="-fx-font-size: 12px; -fx-font-weight: 600;"/>
                    <DatePicker fx:id="datePicker" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Time Slot *" style="-fx-font-size: 12px; -fx-font-weight: 600;"/>
                    <ComboBox fx:id="timeCombo" maxWidth="Infinity" editable="true" promptText="HH:mm"/>
                </VBox>
            </HBox>

            <VBox spacing="4">
                <Label text="Appointment Status *" style="-fx-font-size: 12px; -fx-font-weight: 600;"/>
                <ComboBox fx:id="statusCombo" maxWidth="Infinity"/>
            </VBox>

            <Separator/>

            <!-- ACTION BUTTONS -->
            <HBox spacing="8">
                <Button text="📅 Book New" onAction="#handleBookAppointment" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-primary"/>
                <Button text="💾 Update" onAction="#handleUpdateAppointment" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-success"/>
            </HBox>

            <HBox spacing="8">
                <Button text="✅ Mark Completed" onAction="#handleMarkCompleted" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-secondary"/>
                <Button text="❌ Cancel Appt" onAction="#handleCancelAppointment" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-danger"/>
            </HBox>

            <Button text="🧹 Clear Selection" onAction="#handleClearForm" maxWidth="Infinity" styleClass="btn-secondary"/>
        </VBox>

    </HBox>
</VBox>
