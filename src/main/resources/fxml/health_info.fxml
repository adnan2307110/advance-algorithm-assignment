<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.healthdesk.controller.HealthInfoController"
      spacing="16" style="-fx-padding: 20px;">

    <!-- TOP API ARCHITECTURE BANNER -->
    <VBox styleClass="card" spacing="8" style="-fx-background-color: linear-gradient(to right, #ffffff, #eff6ff); -fx-border-color: #93c5fd;">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="🌐" style="-fx-font-size: 24px;"/>
            <VBox>
                <Label text="External Health Information API &amp; JSON Parser" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0369a1;"/>
                <Label text="Architecture Pipeline: HTTP Request → JSON Response → JSON Parsing → Java HealthInfo Model → JavaFX Display (Background Worker Thread)"
                       style="-fx-font-size: 11px; -fx-text-fill: #1e40af;"/>
            </VBox>
        </HBox>
    </VBox>

    <!-- SEARCH & API TRIGGER BAR -->
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="card" style="-fx-padding: 10px 16px;">
        <Button fx:id="btnFetchApi" text="🌐 Fetch from API (HTTP/JSON)" onAction="#handleFetchApi"
                styleClass="btn-primary" style="-fx-font-weight: bold;"/>

        <ProgressIndicator fx:id="progressIndicator" prefWidth="24" prefHeight="24" visible="false"/>

        <Separator orientation="VERTICAL"/>

        <Label text="Search Topic:" style="-fx-font-weight: bold; -fx-text-fill: #334155;"/>
        <TextField fx:id="searchField" promptText="e.g. Blood Pressure, Sugar, BMI..." prefWidth="250" onKeyReleased="#handleSearch"/>

        <ComboBox fx:id="categoryFilterCombo" prefWidth="170" onAction="#handleFilterCategory"/>

        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblStatus" text="Ready to fetch topics." style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
    </HBox>

    <!-- MAIN BODY: TOPICS TABLE + DETAILED MEDICAL REFERENCE CARD -->
    <HBox spacing="16" VBox.vgrow="ALWAYS">

        <!-- HEALTH TOPICS TABLE -->
        <VBox HBox.hgrow="ALWAYS" styleClass="card" spacing="10">
            <Label text="Clinical Reference Topics (Parsed from JSON)" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
            <TableView fx:id="topicsTableView" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colName" text="Topic / Indicator" prefWidth="180"/>
                    <TableColumn fx:id="colRange" text="Standard Normal Range" prefWidth="180"/>
                    <TableColumn fx:id="colCategory" text="Medical Category" prefWidth="150"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>

        <!-- DETAILED TOPIC CARD -->
        <VBox prefWidth="420" styleClass="card" spacing="14">
            <Label text="Topic Diagnostic Reference" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
            <Separator/>

            <!-- Header of card -->
            <VBox spacing="6">
                <Label fx:id="lblDetailName" text="Select a topic to inspect" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0284c7;"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label fx:id="lblDetailCategory" text="Category: -" styleClass="badge-normal"/>
                </HBox>
            </VBox>

            <!-- Normal Range Badge Card -->
            <VBox spacing="4" style="-fx-background-color: #f0fdf4; -fx-padding: 12px; -fx-background-radius: 8px; -fx-border-color: #bbf7d0; -fx-border-radius: 8px;">
                <Label text="STANDARD NORMAL RANGE:" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #166534;"/>
                <Label fx:id="lblDetailRange" text="-" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #15803d;"/>
            </VBox>

            <!-- Description -->
            <VBox spacing="4" VBox.vgrow="ALWAYS">
                <Label text="Clinical Description &amp; Health Interpretation:" style="-fx-font-weight: 600; -fx-font-size: 12px;"/>
                <TextArea fx:id="txtDescription" editable="false" wrapText="true" prefRowCount="8" VBox.vgrow="ALWAYS"
                          style="-fx-font-size: 13px; -fx-background-color: #f8fafc; -fx-border-color: #e2e8f0;"/>
            </VBox>
        </VBox>

    </HBox>
</VBox>
