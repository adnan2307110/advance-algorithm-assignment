<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.healthdesk.controller.DoctorController"
      spacing="16" style="-fx-padding: 20px;">

    <!-- TOP SEARCH & FILTER BAR -->
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="card" style="-fx-padding: 12px 16px;">
        <Label text="Search Doctor:" style="-fx-font-weight: bold; -fx-text-fill: #334155;"/>
        <TextField fx:id="searchField" promptText="Search by name, specialization, room..." prefWidth="300" onAction="#handleSearch"/>
        <Button text="🔍 Search" onAction="#handleSearch" styleClass="btn-primary"/>
        <Button text="🔄 Refresh / Reset" onAction="#handleReset" styleClass="btn-secondary"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="doctorCountLabel" text="Total Doctors: 0" style="-fx-font-weight: bold; -fx-text-fill: #0284c7;"/>
    </HBox>

    <!-- MAIN BODY: TABLE + FORM -->
    <HBox spacing="16" VBox.vgrow="ALWAYS">

        <!-- DOCTORS TABLEVIEW -->
        <VBox HBox.hgrow="ALWAYS" styleClass="card" spacing="10">
            <Label text="Medical Specialist Staff" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
            <TableView fx:id="doctorTableView" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="colName" text="Doctor Name" prefWidth="160"/>
                    <TableColumn fx:id="colSpec" text="Specialization" prefWidth="130"/>
                    <TableColumn fx:id="colPhone" text="Phone" prefWidth="110"/>
                    <TableColumn fx:id="colRoom" text="Room" prefWidth="70"/>
                    <TableColumn fx:id="colAvailable" text="Available Time" prefWidth="140"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>

        <!-- DOCTOR DETAIL / EDIT FORM -->
        <VBox prefWidth="360" styleClass="card" spacing="12">
            <Label text="Doctor Information" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
            <Separator/>

            <VBox spacing="4">
                <Label text="Doctor Full Name *" style="-fx-font-size: 12px; -fx-font-weight: 600;"/>
                <TextField fx:id="nameField" promptText="e.g. Dr. Sabrina Khan"/>
            </VBox>

            <VBox spacing="4">
                <Label text="Specialization *" style="-fx-font-size: 12px; -fx-font-weight: 600;"/>
                <ComboBox fx:id="specCombo" maxWidth="Infinity" editable="true" promptText="Select or type specialization"/>
            </VBox>

            <HBox spacing="10">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Phone Number *" style="-fx-font-size: 12px; -fx-font-weight: 600;"/>
                    <TextField fx:id="phoneField" promptText="017xxxxxxxx"/>
                </VBox>
                <VBox spacing="4" prefWidth="100">
                    <Label text="Room *" style="-fx-font-size: 12px; -fx-font-weight: 600;"/>
                    <TextField fx:id="roomField" promptText="e.g. 101"/>
                </VBox>
            </HBox>

            <VBox spacing="4">
                <Label text="Available Duty Time *" style="-fx-font-size: 12px; -fx-font-weight: 600;"/>
                <TextField fx:id="availableTimeField" promptText="e.g. 09:00 AM - 01:00 PM"/>
            </VBox>

            <Separator/>

            <!-- FORM BUTTONS -->
            <HBox spacing="8">
                <Button text="➕ Add Doctor" onAction="#handleAddDoctor" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-primary"/>
                <Button text="💾 Update" onAction="#handleUpdateDoctor" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-success"/>
            </HBox>

            <HBox spacing="8">
                <Button text="🗑️ Delete" onAction="#handleDeleteDoctor" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-danger"/>
                <Button text="🧹 Clear" onAction="#handleClearForm" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-secondary"/>
            </HBox>
        </VBox>

    </HBox>
</VBox>
