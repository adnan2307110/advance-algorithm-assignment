<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.healthdesk.controller.DashboardController"
            style="-fx-background-color: transparent; -fx-background: #f8fafc; -fx-border-color: transparent;">

    <VBox spacing="20" style="-fx-padding: 24px;">

        <!-- STATISTIC METRIC CARDS -->
        <GridPane hgap="16" vgap="16">
            <columnConstraints>
                <ColumnConstraints percentWidth="33.33"/>
                <ColumnConstraints percentWidth="33.33"/>
                <ColumnConstraints percentWidth="33.33"/>
            </columnConstraints>

            <!-- Card 1: Patients -->
            <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="stat-card" spacing="4">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="👥" style="-fx-font-size: 20px;"/>
                    <Label text="TOTAL PATIENTS" styleClass="stat-card-title"/>
                </HBox>
                <Label fx:id="lblTotalPatients" text="0" styleClass="stat-card-value"/>
                <Label text="Active medical records in database" styleClass="stat-card-subtitle"/>
            </VBox>

            <!-- Card 2: Doctors -->
            <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="stat-card" spacing="4">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="👨‍⚕️" style="-fx-font-size: 20px;"/>
                    <Label text="TOTAL DOCTORS" styleClass="stat-card-title"/>
                </HBox>
                <Label fx:id="lblTotalDoctors" text="0" styleClass="stat-card-value"/>
                <Label text="Specialists on active clinical duty" styleClass="stat-card-subtitle"/>
            </VBox>

            <!-- Card 3: Today's Appointments -->
            <VBox GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="stat-card" spacing="4">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="📅" style="-fx-font-size: 20px;"/>
                    <Label text="TODAY'S APPOINTMENTS" styleClass="stat-card-title"/>
                </HBox>
                <Label fx:id="lblTodayAppointments" text="0" styleClass="stat-card-value"/>
                <Label text="Outpatient visits scheduled for today" styleClass="stat-card-subtitle"/>
            </VBox>

            <!-- Card 4: Bed Availability -->
            <VBox GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="stat-card" spacing="4">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="🛏️" style="-fx-font-size: 20px;"/>
                    <Label text="AVAILABLE BEDS" styleClass="stat-card-title"/>
                </HBox>
                <HBox alignment="BASELINE_LEFT" spacing="6">
                    <Label fx:id="lblAvailableBeds" text="0" styleClass="stat-card-value" style="-fx-text-fill: #16a34a;"/>
                    <Label fx:id="lblTotalBeds" text="/ 0 Total" style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
                </HBox>
                <Label fx:id="lblOccupiedBeds" text="0 Occupied" styleClass="stat-card-subtitle"/>
            </VBox>

            <!-- Card 5: Emergency Patients -->
            <VBox GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="stat-card" spacing="4">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="🚨" style="-fx-font-size: 20px;"/>
                    <Label text="EMERGENCY PATIENTS" styleClass="stat-card-title"/>
                </HBox>
                <Label fx:id="lblEmergencyPatients" text="0" styleClass="stat-card-value" style="-fx-text-fill: #dc2626;"/>
                <Label text="Active in PriorityQueue triage" styleClass="stat-card-subtitle"/>
            </VBox>

            <!-- Card 6: Pending Lab Tests -->
            <VBox GridPane.columnIndex="2" GridPane.rowIndex="1" styleClass="stat-card" spacing="4">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="🔬" style="-fx-font-size: 20px;"/>
                    <Label text="PENDING LAB TESTS" styleClass="stat-card-title"/>
                </HBox>
                <Label fx:id="lblPendingLabTests" text="0" styleClass="stat-card-value" style="-fx-text-fill: #d97706;"/>
                <Label text="Diagnostic specimens in processing" styleClass="stat-card-subtitle"/>
            </VBox>
        </GridPane>

        <!-- QUICK ACTION SHORTCUTS -->
        <VBox styleClass="card" spacing="12">
            <Label text="⚡ Quick Operations" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
            <HBox spacing="10" wrapText="true">
                <Button text="➕ Register Patient" onAction="#navPatients" styleClass="btn-primary"/>
                <Button text="📅 Book Appointment" onAction="#navAppointments" styleClass="btn-primary"/>
                <Button text="🚨 Triage Emergency" onAction="#navEmergency" styleClass="btn-danger"/>
                <Button text="🛏️ Assign Bed" onAction="#navBeds" styleClass="btn-secondary"/>
                <Button text="🔬 Request Lab Test" onAction="#navLab" styleClass="btn-secondary"/>
                <Button text="💊 New Prescription" onAction="#navPrescriptions" styleClass="btn-secondary"/>
                <Button text="💵 Billing" onAction="#navBilling" styleClass="btn-secondary"/>
                <Button text="ℹ️ Health Reference API" onAction="#navHealthInfo" styleClass="btn-secondary"/>
            </HBox>
        </VBox>

        <!-- DUAL TABLES: TODAY'S SCHEDULE & EMERGENCY TRIAGE QUEUE -->
        <HBox spacing="20">
            <!-- Today's Appointments -->
            <VBox HBox.hgrow="ALWAYS" styleClass="card" spacing="10" prefWidth="540">
                <HBox alignment="CENTER_LEFT">
                    <Label text="📅 Today's Appointments" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="View All" onAction="#navAppointments" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 3px 8px;"/>
                </HBox>
                <TableView fx:id="tblTodayAppointments" prefHeight="220">
                    <columns>
                        <TableColumn fx:id="colApptTime" text="Time" prefWidth="80"/>
                        <TableColumn fx:id="colApptPatient" text="Patient" prefWidth="150"/>
                        <TableColumn fx:id="colApptDoctor" text="Doctor" prefWidth="150"/>
                        <TableColumn fx:id="colApptStatus" text="Status" prefWidth="110"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>

            <!-- Live Emergency PriorityQueue -->
            <VBox HBox.hgrow="ALWAYS" styleClass="card" spacing="10" prefWidth="540">
                <HBox alignment="CENTER_LEFT">
                    <Label text="🚨 Emergency Triage Queue" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Process Next" onAction="#handleProcessEmergency" styleClass="btn-danger" style="-fx-font-size: 11px; -fx-padding: 3px 8px;"/>
                </HBox>
                <TableView fx:id="tblEmergencyQueue" prefHeight="220">
                    <columns>
                        <TableColumn fx:id="colEmergPriority" text="Priority" prefWidth="90"/>
                        <TableColumn fx:id="colEmergPatient" text="Patient" prefWidth="150"/>
                        <TableColumn fx:id="colEmergCondition" text="Condition" prefWidth="180"/>
                        <TableColumn fx:id="colEmergStatus" text="Status" prefWidth="90"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </HBox>

    </VBox>
</ScrollPane>
