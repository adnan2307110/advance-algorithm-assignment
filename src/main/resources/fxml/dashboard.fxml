<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.healthdesk.controller.DashboardController"
            style="-fx-background-color: transparent; -fx-background: #f0f4f8; -fx-border-color: transparent;">

    <VBox spacing="22" style="-fx-padding: 26px;">

        <!-- ═══ KEY PERFORMANCE METRICS ═══ -->
        <GridPane hgap="18" vgap="18">
            <columnConstraints>
                <ColumnConstraints percentWidth="33.33"/>
                <ColumnConstraints percentWidth="33.33"/>
                <ColumnConstraints percentWidth="33.33"/>
            </columnConstraints>

            <!-- Card 1: Patient Census -->
            <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="stat-card" spacing="5">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="👥" style="-fx-font-size: 20px;"/>
                    <Label text="PATIENT CENSUS" styleClass="stat-card-title"/>
                </HBox>
                <Label fx:id="lblTotalPatients" text="0" styleClass="stat-card-value"/>
                <Label text="Registered patients in the system" styleClass="stat-card-subtitle"/>
            </VBox>

            <!-- Card 2: Active Medical Staff -->
            <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="stat-card" spacing="5">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="👨‍⚕️" style="-fx-font-size: 20px;"/>
                    <Label text="ACTIVE MEDICAL STAFF" styleClass="stat-card-title"/>
                </HBox>
                <Label fx:id="lblTotalDoctors" text="0" styleClass="stat-card-value"/>
                <Label text="Physicians on active clinical duty" styleClass="stat-card-subtitle"/>
            </VBox>

            <!-- Card 3: Today's Consultations -->
            <VBox GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="stat-card" spacing="5">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="📅" style="-fx-font-size: 20px;"/>
                    <Label text="TODAY'S CONSULTATIONS" styleClass="stat-card-title"/>
                </HBox>
                <Label fx:id="lblTodayAppointments" text="0" styleClass="stat-card-value"/>
                <Label text="Outpatient visits scheduled for today" styleClass="stat-card-subtitle"/>
            </VBox>

            <!-- Card 4: Inpatient Bed Availability -->
            <VBox GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="stat-card" spacing="5">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="🛏️" style="-fx-font-size: 20px;"/>
                    <Label text="INPATIENT BED AVAILABILITY" styleClass="stat-card-title"/>
                </HBox>
                <HBox alignment="BASELINE_LEFT" spacing="6">
                    <Label fx:id="lblAvailableBeds" text="0" styleClass="stat-card-value" style="-fx-text-fill: #16a34a;"/>
                    <Label fx:id="lblTotalBeds" text="/ 0 Total Beds" style="-fx-font-size: 14px; -fx-text-fill: #5d7a95;"/>
                </HBox>
                <Label fx:id="lblOccupiedBeds" text="0 Currently Occupied" styleClass="stat-card-subtitle"/>
            </VBox>

            <!-- Card 5: Emergency Triage Status -->
            <VBox GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="stat-card" spacing="5">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="🚨" style="-fx-font-size: 20px;"/>
                    <Label text="EMERGENCY TRIAGE STATUS" styleClass="stat-card-title"/>
                </HBox>
                <Label fx:id="lblEmergencyPatients" text="0" styleClass="stat-card-value" style="-fx-text-fill: #dc2626;"/>
                <Label text="Patients awaiting urgent intervention" styleClass="stat-card-subtitle"/>
            </VBox>

            <!-- Card 6: Pending Diagnostics -->
            <VBox GridPane.columnIndex="2" GridPane.rowIndex="1" styleClass="stat-card" spacing="5">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="🔬" style="-fx-font-size: 20px;"/>
                    <Label text="PENDING DIAGNOSTICS" styleClass="stat-card-title"/>
                </HBox>
                <Label fx:id="lblPendingLabTests" text="0" styleClass="stat-card-value" style="-fx-text-fill: #d97706;"/>
                <Label text="Lab specimens awaiting analysis" styleClass="stat-card-subtitle"/>
            </VBox>
        </GridPane>

        <!-- ═══ QUICK CLINICAL ACTIONS ═══ -->
        <VBox styleClass="card" spacing="14">
            <Label text="⚡  Quick Clinical Actions" style="-fx-font-size: 15px; -fx-font-weight: 800; -fx-text-fill: #0d1b2a;"/>
            <HBox spacing="10" wrapText="true">
                <Button text="➕  Admit Patient"          onAction="#navPatients"      styleClass="btn-primary"/>
                <Button text="📅  Schedule Consultation"  onAction="#navAppointments"  styleClass="btn-primary"/>
                <Button text="🚨  Initiate Triage"        onAction="#navEmergency"     styleClass="btn-danger"/>
                <Button text="🛏️  Assign Ward Bed"        onAction="#navBeds"          styleClass="btn-secondary"/>
                <Button text="🔬  Order Diagnostic Test"  onAction="#navLab"           styleClass="btn-secondary"/>
                <Button text="💊  Issue Prescription"     onAction="#navPrescriptions" styleClass="btn-secondary"/>
                <Button text="💳  Generate Invoice"       onAction="#navBilling"       styleClass="btn-secondary"/>
                <Button text="🌐  Health Reference"       onAction="#navHealthInfo"    styleClass="btn-secondary"/>
            </HBox>
        </VBox>

        <!-- ═══ LIVE SCHEDULE & TRIAGE PANELS ═══ -->
        <HBox spacing="20">
            <!-- Today's Appointment Schedule -->
            <VBox HBox.hgrow="ALWAYS" styleClass="card" spacing="12" prefWidth="540">
                <HBox alignment="CENTER_LEFT">
                    <Label text="📅  Today's Appointment Schedule" style="-fx-font-size: 15px; -fx-font-weight: 800; -fx-text-fill: #0d1b2a;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="View Full Schedule" onAction="#navAppointments" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 4px 10px;"/>
                </HBox>
                <TableView fx:id="tblTodayAppointments" prefHeight="220">
                    <columns>
                        <TableColumn fx:id="colApptTime"    text="Time"       prefWidth="80"/>
                        <TableColumn fx:id="colApptPatient" text="Patient"    prefWidth="150"/>
                        <TableColumn fx:id="colApptDoctor"  text="Physician"  prefWidth="150"/>
                        <TableColumn fx:id="colApptStatus"  text="Status"     prefWidth="110"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>

            <!-- Live Emergency Triage Queue -->
            <VBox HBox.hgrow="ALWAYS" styleClass="card" spacing="12" prefWidth="540">
                <HBox alignment="CENTER_LEFT">
                    <Label text="🚨  Emergency Triage Queue" style="-fx-font-size: 15px; -fx-font-weight: 800; -fx-text-fill: #0d1b2a;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Dispatch Next Patient" onAction="#handleProcessEmergency" styleClass="btn-danger" style="-fx-font-size: 11px; -fx-padding: 4px 10px;"/>
                </HBox>
                <TableView fx:id="tblEmergencyQueue" prefHeight="220">
                    <columns>
                        <TableColumn fx:id="colEmergPriority"  text="Severity"   prefWidth="90"/>
                        <TableColumn fx:id="colEmergPatient"   text="Patient"    prefWidth="150"/>
                        <TableColumn fx:id="colEmergCondition" text="Condition"  prefWidth="180"/>
                        <TableColumn fx:id="colEmergStatus"    text="Status"     prefWidth="90"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </HBox>

    </VBox>
</ScrollPane>
