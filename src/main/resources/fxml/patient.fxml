<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.healthdesk.controller.PatientController"
      spacing="16" style="-fx-padding: 20px;">

    <!-- TOP SEARCH & FILTER BAR -->
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="card" style="-fx-padding: 12px 16px;">
        <Label text="Search Patient:" style="-fx-font-weight: bold; -fx-text-fill: #334155;"/>
        <TextField fx:id="searchField" promptText="Search by name, phone, blood group..." prefWidth="300" onAction="#handleSearch"/>
        <Button text="🔍 Search" onAction="#handleSearch" styleClass="btn-primary"/>
        <Button text="🔄 Refresh / Reset" onAction="#handleReset" styleClass="btn-secondary"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="patientCountLabel" text="Total Patients: 0" style="-fx-font-weight: bold; -fx-text-fill: #0284c7;"/>
    </HBox>

    <!-- MAIN BODY: TABLE + FORM -->
    <HBox spacing="16" VBox.vgrow="ALWAYS">

        <!-- PATIENT TABLEVIEW -->
        <VBox HBox.hgrow="ALWAYS" styleClass="card" spacing="10">
            <Label text="Patient Directory" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
            <TableView fx:id="patientTableView" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="colName" text="Name" prefWidth="140"/>
                    <TableColumn fx:id="colAge" text="Age" prefWidth="60"/>
                    <TableColumn fx:id="colGender" text="Gender" prefWidth="75"/>
                    <TableColumn fx:id="colBloodGroup" text="Blood Group" prefWidth="90"/>
                    <TableColumn fx:id="colPhone" text="Phone" prefWidth="110"/>
                    <TableColumn fx:id="colEmergency" text="Emergency Contact" prefWidth="130"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>

        <!-- PATIENT DETAIL / EDIT FORM -->
        <VBox prefWidth="360" styleClass="card" spacing="12">
            <Label text="Patient Details" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
            <Separator/>

            <VBox spacing="4">
                <Label text="Full Name *" style="-fx-font-size: 12px; -fx-font-weight: 600;"/>
                <TextField fx:id="nameField" promptText="e.g. Adnan Hossain"/>
            </VBox>

            <HBox spacing="10">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Age *" style="-fx-font-size: 12px; -fx-font-weight: 600;"/>
                    <TextField fx:id="ageField" promptText="e.g. 25"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Gender *" style="-fx-font-size: 12px; -fx-font-weight: 600;"/>
                    <ComboBox fx:id="genderCombo" maxWidth="Infinity"/>
                </VBox>
            </HBox>

            <HBox spacing="10">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Blood Group *" style="-fx-font-size: 12px; -fx-font-weight: 600;"/>
                    <ComboBox fx:id="bloodGroupCombo" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Phone Number *" style="-fx-font-size: 12px; -fx-font-weight: 600;"/>
                    <TextField fx:id="phoneField" promptText="017xxxxxxxx"/>
                </VBox>
            </HBox>

            <VBox spacing="4">
                <Label text="Address" style="-fx-font-size: 12px; -fx-font-weight: 600;"/>
                <TextField fx:id="addressField" promptText="Street, City"/>
            </VBox>

            <VBox spacing="4">
                <Label text="Emergency Contact Phone" style="-fx-font-size: 12px; -fx-font-weight: 600;"/>
                <TextField fx:id="emergencyContactField" promptText="Kin phone number"/>
            </VBox>

            <Separator/>

            <!-- FORM BUTTONS -->
            <HBox spacing="8">
                <Button text="➕ Add" onAction="#handleAddPatient" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-primary"/>
                <Button text="💾 Update" onAction="#handleUpdatePatient" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-success"/>
            </HBox>

            <HBox spacing="8">
                <Button text="🗑️ Delete" onAction="#handleDeletePatient" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-danger"/>
                <Button text="🧹 Clear" onAction="#handleClearForm" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-secondary"/>
            </HBox>
        </VBox>

    </HBox>
</VBox>
